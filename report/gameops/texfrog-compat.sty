\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{texfrog-compat}[2026/09/13 e-type expl3 variants needed by texfrog on pre-2024 kernels]
% texfrog.sty (2025) uses e-type expl3 argument variants that the LaTeX
% kernel only declares from 2023-10 onwards.  TeX Live 2023 ships expl3
% 2023-02-22, where they are missing, which makes \tfonly and
% \tfrenderfigure fail with "Undefined control sequence \tl_set:Ne".
% Generating them explicitly is enough; e-type expansion itself is supported.
% Load this BEFORE texfrog.  Harmless on newer kernels (each guard is a no-op).
\RequirePackage{expl3}
\ExplSyntaxOn
\cs_if_exist:NF \tl_set:Ne        { \cs_generate_variant:Nn \tl_set:Nn        { Ne    } }
\cs_if_exist:NF \tl_gset:Ne       { \cs_generate_variant:Nn \tl_gset:Nn       { Ne    } }
\cs_if_exist:NF \prop_put:Nen     { \cs_generate_variant:Nn \prop_put:Nnn     { Nen   } }
\cs_if_exist:NF \prop_gput:Nen    { \cs_generate_variant:Nn \prop_gput:Nnn    { Nen   } }
\cs_if_exist:NF \prop_gput:Nee    { \cs_generate_variant:Nn \prop_gput:Nnn    { Nee   } }
\cs_if_exist:NF \prop_if_in:NeTF  { \cs_generate_variant:Nn \prop_if_in:NnTF  { NeTF  } }
\cs_if_exist:NF \prop_if_in:NeT   { \cs_generate_variant:Nn \prop_if_in:NnT   { NeT   } }
\cs_if_exist:NF \prop_if_in:NeF   { \cs_generate_variant:Nn \prop_if_in:NnF   { NeF   } }
\cs_if_exist:NF \str_if_eq:eeT    { \cs_generate_variant:Nn \str_if_eq:nnT    { eeT   } }
\cs_if_exist:NF \msg_warning:nneee{ \cs_generate_variant:Nn \msg_warning:nnnnn{ nneee } }
\ExplSyntaxOff
